# Maintainer: Bagas
# Local Arch package for Wangsap (com.wangsap)

pkgname=wangsap
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial WhatsApp Web desktop client for Linux (Tauri 2)"
arch=('x86_64' 'aarch64')
url="https://github.com/bagaskara815/Wangsap"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'hicolor-icon-theme'
  'libappindicator'
  'openssl'
)
makedepends=(
  'nodejs'
  'npm'
  'pkgconf'
  'git'
)
# Rust via rustup is fine for local builds (`~/.cargo/bin` on PATH).
# Install Arch `rust`/`cargo` packages if you prefer distro toolchain.
# Binary is Rust/Tauri — LTO across crate graph often breaks link
options=(!lto !debug)
source=()
sha256sums=()

_project="$(cd "${startdir}/../.." && pwd)"
_cargo_target="${srcdir}/cargo-target"

prepare() {
  # Snapshot project into srcdir (skip heavy/ephemeral dirs)
  rm -rf "${srcdir}/${pkgname}"
  mkdir -p "${srcdir}/${pkgname}"
  bsdtar \
    --exclude='./node_modules' \
    --exclude='./src-tauri/target' \
    --exclude='./.git' \
    --exclude='./packaging/arch/pkg' \
    --exclude='./packaging/arch/src' \
    --exclude='./packaging/arch/*.pkg.tar*' \
    --exclude='./packaging/arch/*.log' \
    -cf - -C "${_project}" . \
    | bsdtar -xf - -C "${srcdir}/${pkgname}"
}

build() {
  cd "${srcdir}/${pkgname}"

  # Prefer rustup toolchain if present (Arch rust package optional)
  export PATH="${HOME}/.cargo/bin:${PATH}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export npm_config_cache="${srcdir}/npm-cache"
  export CARGO_TARGET_DIR="${srcdir}/cargo-target"

  # Ensure esbuild postinstall allowed if npm blocks scripts
  if command -v npm >/dev/null; then
    npm install --include=dev
    # unblock esbuild native binary if needed
    if npm install-scripts ls 2>/dev/null | grep -q esbuild; then
      npm install-scripts approve esbuild 2>/dev/null || true
      npm rebuild esbuild 2>/dev/null || true
    fi
  fi

  # Release binary only (no deb/rpm/appimage — Arch uses this PKGBUILD)
  npm run tauri build -- --no-bundle
}

package() {
  cd "${srcdir}/${pkgname}"

  local _bin="${srcdir}/cargo-target/release/wangsap"
  if [[ ! -x "${_bin}" ]]; then
    _bin="${srcdir}/${pkgname}/src-tauri/target/release/wangsap"
  fi

  install -Dm755 "${_bin}" "${pkgdir}/usr/bin/wangsap"

  # Desktop entry (system)
  install -Dm644 "${_project}/packaging/arch/com.wangsap.desktop" \
    "${pkgdir}/usr/share/applications/com.wangsap.desktop"
  # Alias matching binary WM class
  sed 's/^Icon=com.wangsap$/Icon=wangsap/; s/^StartupWMClass=com.wangsap$/StartupWMClass=wangsap/' \
    "${_project}/packaging/arch/com.wangsap.desktop" \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/wangsap.desktop"

  # Icons
  local _icons="${srcdir}/${pkgname}/src-tauri/icons"
  install -Dm644 "${_icons}/32x32.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/com.wangsap.png"
  install -Dm644 "${_icons}/64x64.png" \
    "${pkgdir}/usr/share/icons/hicolor/64x64/apps/com.wangsap.png"
  install -Dm644 "${_icons}/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/com.wangsap.png"
  install -Dm644 "${_icons}/128x128@2x.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.wangsap.png"
  install -Dm644 "${_icons}/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/com.wangsap.png"
  install -Dm644 "${_icons}/whatsapp.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.wangsap.svg"

  # Duplicate under binary name for KWin resourceClass=wangsap
  for sz in 32x32 64x64 128x128 256x256 512x512; do
    if [[ -f "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/com.wangsap.png" ]]; then
      install -Dm644 \
        "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/com.wangsap.png" \
        "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/wangsap.png"
    fi
  done
  install -Dm644 "${_icons}/whatsapp.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/wangsap.svg"

  # License + docs
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  else
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<'EOF'
MIT License

Copyright (c) 2026 Bagas

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
EOF
  fi
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
