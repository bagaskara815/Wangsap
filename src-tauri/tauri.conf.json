{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wangsap",
  "version": "0.1.0",
  "identifier": "com.wangsap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "category": "SocialNetworking",
    "shortDescription": "WhatsApp Web desktop client for Linux",
    "longDescription": "Lightweight unofficial WhatsApp Web wrapper built with Tauri 2. System tray, persistent sessions, multi-profile ready."
  },
  "plugins": {}
}
