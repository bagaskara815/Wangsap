{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Wangsap local windows",
  "windows": ["main", "settings", "wa-*"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-is-visible",
    "core:webview:allow-create-webview-window",
    "core:tray:default",
    "opener:default",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "allow-list-profiles",
    "allow-create-profile",
    "allow-create-next-profile",
    "allow-rename-profile",
    "allow-delete-profile",
    "allow-open-profile",
    "allow-show-profile",
    "allow-hide-all-profiles",
    "allow-open-settings",
    "allow-set-unread-count",
    "allow-get-unread-total"
  ]
}
